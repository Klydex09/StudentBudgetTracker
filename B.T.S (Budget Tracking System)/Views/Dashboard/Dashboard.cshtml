@* Sidebar navigation for secured modules *@
<aside>
    <nav>
        <a href="/Dashboard/Dashboard">Dashboard</a>
        <a href="/Budget/Add">Add Budget</a>
        <a href="/Budget/Records">Budget History</a>
        <a href="/Report/Summary">Summary / Charts</a>
        <a href="/Account/Logout">Logout</a>
    </nav>
</aside>

<main>
    <div class="dashboard-header">
        @* Main title and welcome message from DashboardController *@
        <h1>Student Allowance and Expense Tracker</h1>
        <p>Welcome, @ViewBag.Username!</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(ViewBag.BalanceAlertMessage))
    {
        @* Warning shown when the remaining balance is too low or already negative *@
        <div class="status-alert @ViewBag.BalanceAlertClass">
            @ViewBag.BalanceAlertMessage
        </div>
    }

    @* Summary cards that show the totals computed in the controller *@
    <div class="dashboard-status">
        <div class="status-box"><strong>Total Allowance:</strong> &#8369;@ViewBag.TotalAllowance</div>
        <div class="status-box"><strong>Total Expenses:</strong> &#8369;@ViewBag.TotalExpenses</div>
        <div class="status-box"><strong>Remaining Balance:</strong> &#8369;@ViewBag.RemainingBalance</div>
    </div>

    <div class="dashboard-recent">
        <h2>Recent Transactions</h2>

        @if (!string.IsNullOrWhiteSpace(ViewBag.EmptyDashboardMessage))
        {
            <div class="empty-state">
                <p>@ViewBag.EmptyDashboardMessage</p>
            </div>
        }
        else
        {
            @* Table that displays only the most recent transactions *@
            <table class="record-container">
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Allowance</th>
                    <th>Expenses</th>
                    <th>Remaining Balance</th>
                </tr>

                @* Loops through the recent transactions passed from the controller *@
                @foreach (var item in ViewBag.RecentTransactions)
                {
                    <tr>
                        <td>@item.Date.ToShortDateString()</td>
                        <td>@item.Description</td>
                        <td>&#8369;@item.Allowance</td>
                        <td>&#8369;@item.Expenses</td>
                        <td>&#8369;@item.RemainingBalance</td>
                    </tr>
                }
            </table>
        }
    </div>

    @* Quick action buttons for common dashboard tasks *@
    <div class="dashboard-bottom-btn">
        <a href="/Budget/Add" class="add-btn">Add Budget</a>
        <a href="/Budget/Records" class="add-btn">View Records</a>
    </div>
</main>
