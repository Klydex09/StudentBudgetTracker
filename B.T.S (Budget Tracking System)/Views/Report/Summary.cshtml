@using StudentBudgetTracker.Models
@model IEnumerable<Budget>
@{
    var selectedFilter = (ViewBag.Filter as string) ?? "overall";
}

<aside>
    <nav>
        <a href="/Dashboard/Dashboard">Dashboard</a>
        <a href="/Budget/Add">Add Budget</a>
        <a href="/Budget/Records">Budget History</a>
        <a href="/Report/Summary">Summary / Charts</a>
        <a href="/Account/Logout">Logout</a>
    </nav>
</aside>

<main>
    <div class="dashboard-header">
        <h1>Summary Charts</h1>
    </div>

    <div class="dashboard-status">
        <div class="status-box"><strong>Total Allowance:</strong> &#8369;@ViewBag.TotalAllowance</div>
        <div class="status-box"><strong>Total Expenses:</strong> &#8369;@ViewBag.TotalExpenses</div>
        <div class="status-box"><strong>Remaining Balance:</strong> &#8369;@ViewBag.RemainingBalance</div>
    </div>

    <form method="get" class="filter-panel">
        <div class="filter-grid summary-filter-grid">
            <div class="filter-group">
                <label>Report Filter</label>
                <select name="filter" onchange="this.form.submit()">
                    <option value="overall" selected="@(selectedFilter == "overall" ? "selected" : null)">Overall</option>
                    <option value="daily" selected="@(selectedFilter == "daily" ? "selected" : null)">Daily</option>
                    <option value="weekly" selected="@(selectedFilter == "weekly" ? "selected" : null)">Weekly</option>
                    <option value="monthly" selected="@(selectedFilter == "monthly" ? "selected" : null)">Monthly</option>
                </select>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h2>No Summary Data</h2>
            <p>@ViewBag.EmptySummaryMessage</p>
        </div>
    }
    else
    {
        <div class="daily-chart">
            <div class="chart-shell">
                <canvas id="chart"></canvas>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        var labels = @Html.Raw(ViewBag.Labels);
        var data = @Html.Raw(ViewBag.Data);
        var ctx = document.getElementById("chart");

        if (ctx && labels.length > 0 && data.length > 0) {
            new Chart(ctx, {
                type: "pie",
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Expenses by Description",
                        data: data,
                        backgroundColor: [
                            "#6cb4ee",
                            "#ff8a80",
                            "#81c784",
                            "#ffd54f",
                            "#9575cd",
                            "#80cbc4"
                        ],
                        borderColor: "#ffffff",
                        borderWidth: 2
                    }]
                }
            });
        }
    </script>
</main>
