<aside>
    <nav>
        <a href="/Dashboard/Dashboard">Dashboard</a>
        <a href="/Budget/Add">Add Budget</a>
        <a href="/Budget/Records">Budget History</a>
        <a href="/Report/Summary">Summary / Charts</a>
        <a href="/Account/Logout">Logout</a>
    </nav>
</aside>

<main>
    <div class="add-container">
        <h1 class="add-title">Add Budget</h1>

        <form method="post" class="add-form">
            <div class="add-group">
                <label>Allowance</label>
                <input type="number" name="Allowance" step="0.01" placeholder="Enter amount">
            </div>

            <div class="add-group">
                <label>Expenses</label>
                <input type="number" name="Expenses" step="0.01" placeholder="Enter amount" required>
            </div>

            <div class="add-group">
                <label>Description</label>
                <input type="text" name="Description" placeholder="Enter description" required>
            </div>

            <div class="add-group">
                <label>Type</label>
                <select name="Category" class="category-select" data-custom-target="addCustomCategory">
                    <option>None</option>
                    <option>Food</option>
                    <option>Transportation</option>
                    <option>School</option>
                    <option>Other</option>
                </select>
            </div>

            <div id="addCustomCategory" class="add-group custom-category-group hidden">
                <label>Specify Other Category</label>
                <input type="text" name="customCategory" placeholder="Type your custom category">
            </div>

            <div class="add-group">
                <label>Date</label>
                <input type="date" name="Date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
            </div>

            <div class="add-group">
                <label>Remarks</label>
                <textarea name="Remarks" rows="4" placeholder="Add notes or remarks about this entry"></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="add-btn">Add Budget</button>
                <button type="reset" class="secondary-btn">Clear Form</button>
            </div>
        </form>
    </div>
</main>
