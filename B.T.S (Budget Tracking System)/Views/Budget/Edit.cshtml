@model StudentBudgetTracker.Models.Budget

@{
    var presetCategories = new[] { "None", "Food", "Transportation", "School" };
    var useOtherCategory = !presetCategories.Contains(Model.Category);
    var selectedCategory = useOtherCategory ? "Other" : Model.Category;
    var customCategory = useOtherCategory ? Model.Category : string.Empty;
}

<aside>
    <nav>
        <a href="/Dashboard/Dashboard">Dashboard</a>
        <a href="/Budget/Add">Add Budget</a>
        <a href="/Budget/Records">Budget History</a>
        <a href="/Report/Summary">Summary / Charts</a>
        <a href="/Account/Logout">Logout</a>
    </nav>
</aside>

<main>
    <div class="add-container">
        <h1 class="add-title">Edit Budget</h1>

        <form method="post" class="add-form">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="add-group">
                <label>Date</label>
                <input type="date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />
            </div>

            <div class="add-group">
                <label>Description</label>
                <input type="text" name="Description" value="@Model.Description" />
            </div>

            <div class="add-group">
                <label>Allowance</label>
                <input type="number" name="Allowance" step="0.01" value="@Model.Allowance" />
            </div>

            <div class="add-group">
                <label>Expenses</label>
                <input type="number" name="Expenses" step="0.01" value="@Model.Expenses" />
            </div>

            <div class="add-group">
                <label>Type</label>
                <select name="Category" class="category-select" data-custom-target="editCustomCategory">
                    <option selected="@(selectedCategory == "None" ? "selected" : null)">None</option>
                    <option selected="@(selectedCategory == "Food" ? "selected" : null)">Food</option>
                    <option selected="@(selectedCategory == "Transportation" ? "selected" : null)">Transportation</option>
                    <option selected="@(selectedCategory == "School" ? "selected" : null)">School</option>
                    <option selected="@(selectedCategory == "Other" ? "selected" : null)">Other</option>
                </select>
            </div>

            <div id="editCustomCategory" class="add-group custom-category-group @(useOtherCategory ? string.Empty : "hidden")">
                <label>Specify Other Category</label>
                <input type="text" name="customCategory" value="@customCategory" placeholder="Type your custom category">
            </div>

            <div class="add-group">
                <label>Remarks</label>
                <textarea name="Remarks" rows="4" placeholder="Add notes or remarks about this entry">@Model.Remarks</textarea>
            </div>

            <div class="form-actions">
                <button class="add-btn" type="submit">Save Changes</button>
                <button type="reset" class="secondary-btn">Reset</button>
            </div>
        </form>
    </div>
</main>
